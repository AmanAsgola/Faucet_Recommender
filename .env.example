# Faucet POC Configuration
FAUCET_CATALOG_CSV=data/products.csv
FAUCET_IMAGE_MANIFEST_CSV=data/image_manifest.csv
FAUCET_INDEX_PATH=data/processed/faucet_index.faiss
FAUCET_METADATA_PATH=data/processed/faucet_metadata.json
FAUCET_MANIFEST_PATH=data/processed/index_manifest.json
FAUCET_SQLITE_PATH=data/processed/faucet_catalog.db

# OpenCLIP Settings
OPENCLIP_MODEL_NAME=ViT-B-32
OPENCLIP_PRETRAINED=openai
EMBEDDING_DEVICE=cpu

# Validation & Retrieval Thresholds
MAX_IMAGE_FILE_SIZE_MB=10
MIN_IMAGE_DIMENSION=50
MAX_IMAGE_DIMENSION=10000
RETRIEVAL_TOP_K=50
DISPLAY_TOP_K=3

# Confidence Thresholds (Marked uncalibrated baseline)
SIMILARITY_THRESHOLD_HIGH=0.85
SIMILARITY_THRESHOLD_LOW=0.80
MARGIN_THRESHOLD=0.03

# Hybrid Reranking Weights (sum to 1.0)
WEIGHT_IMAGE=0.60
WEIGHT_TEXT=0.20
WEIGHT_ATTRIBUTES=0.15
WEIGHT_CATALOG_QUALITY=0.05

